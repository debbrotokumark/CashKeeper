<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/homeback"
    tools:context=".LancherActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/draggable_icon"
        android:fontFamily="@font/lobster"
        android:gravity="center"
        android:layout_marginBottom="40dp"
        android:paddingHorizontal="30dp"
        android:text="@string/app_name"
        android:textSize="34sp"
        android:textColor="@color/deepblue"
        />

    <ImageView
        android:id="@+id/draggable_icon"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        android:importantForAccessibility="no"
        android:src="@drawable/icone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/draggable_icon"
        android:fontFamily="@font/lobster"
        android:gravity="center"
        android:paddingHorizontal="30dp"
        android:text="@string/tct"
        android:textSize="25sp" />

    <Button
        android:id="@+id/confirm_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="10dp"
        android:background="@drawable/buttonback"
        android:paddingVertical="10dp"
        android:text="@string/continue1"
        android:textSize="20sp"
        app:backgroundTint="@null" />
</RelativeLayout>